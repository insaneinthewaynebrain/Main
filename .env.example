# Environment variables the server functions need.
# On Netlify: Site configuration → Environment variables (do NOT commit values).
# Locally (optional): copy this file to .env and fill in values. .env is git-ignored.
# With no DVLA_API_KEY, `npm run dev` runs in mock mode with sample cars.

# Passcode you type once on your phone to unlock lookups.
APP_PASSCODE=

# DVLA Vehicle Enquiry Service
DVLA_API_KEY=

# DVSA MOT History API (from the DVSA registration email)
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_API_KEY=
MOT_SCOPE_URL=
MOT_TOKEN_URL=

# Optional: set to 1 to force sample cars even when keys are present.
MOCK_MODE=
